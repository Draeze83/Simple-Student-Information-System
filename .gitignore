# Ignore compiled Java classes
*.class

# Ignore any file with a $ in its name
*$*

# (optional) ignore common build folders
/bin/
/build/
/out/
/target/

# Ignore runtime CSV data (app starts with an empty database)
/Main/Data/*.csv

# Ignore backup/temp files generated by CSVManager on every save
*.bak
*.backup
*.tmp
